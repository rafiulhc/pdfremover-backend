# Copy to .env for local development. Never commit .env.
PORT=4000
HEAVY_CONCURRENCY=2
# Comma-separated; defaults to localhost:3000 + the production domains
# CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLOUDCONVERT_API_KEY=
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_PERMALINK=ubtedo
GUMROAD_PRODUCT_PERMALINK_RESUME=nktxk

# Only needed outside Docker if the binaries aren't in the usual places
# SOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
